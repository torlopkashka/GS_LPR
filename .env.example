# Скопируйте в .env и заполните (setup.ps1 делает это автоматически).
TZ=Europe/Moscow

ADMIN_USER=admin
ADMIN_PASSWORD=change-me-strong-password
SECRET_KEY=REPLACE_random_hex_32
AGENT_TOKEN=REPLACE_random_hex_32     # тот же токен — в agent\agent.yaml
API_TOKEN=                            # необязательно: для /api/open из автоматизаций

TELEGRAM_TOKEN=                       # токен бота от @BotFather
TELEGRAM_CHAT_IDS=                    # id чатов через запятую
# Только если api.telegram.org недоступен с этого ПК (см. docs/telegram.md):
TELEGRAM_PROXY=                       # socks5://user:pass@host:1080 или http://host:3128
TELEGRAM_API_URL=                     # свой адрес Bot API, например https://tg.example.ru

# Внешний сторож (см. docs/telegram.md). Если ПК или интернет на объекте пропадут,
# сторож сам напишет в Telegram. Uptime Kuma: http://IP-VPS:3001/api/push/<токен>
# healthchecks.io: https://hc-ping.com/<uuid>
HEALTHCHECK_URL=

COOKIE_SECURE=0
LOG_LEVEL=INFO
