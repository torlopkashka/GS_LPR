# Скопируйте в .env и заполните. Случайные значения: openssl rand -hex 32

LPR_DOMAIN=lpr.example.ru
COOKIE_SECURE=1                 # 1 — если сайт открывается по HTTPS
TZ=Europe/Moscow

ADMIN_USER=admin
ADMIN_PASSWORD=change-me-strong-password
SECRET_KEY=REPLACE_openssl_rand_hex_32
AGENT_TOKEN=REPLACE_openssl_rand_hex_32   # тот же токен — в agent.yaml
API_TOKEN=                                # необязательно: для /api/open из автоматизаций

TELEGRAM_TOKEN=                 # токен бота от @BotFather (необязательно)
TELEGRAM_CHAT_IDS=              # id чатов через запятую

LOG_LEVEL=INFO
