# Настройки VPS. setup.sh создаёт .env из этого файла и сам заполняет ключи.
TZ=Europe/Moscow

# Битрикс24 (docs/vps.md, шаг 5)
B24_WEBHOOK_URL=                  # входящий вебхук с правами imbot
B24_BOT_TOKEN=REPLACE_random_32   # секрет бота, до 40 символов; не меняйте после первого запуска
B24_USER_IDS=                     # ID сотрудников, которым доступен бот, через запятую
B24_DIALOG_ID=                    # пусто — бот сам создаст чат «Ворота»; или chat123

# Секрет для запросов с ПК у ворот: то же значение — VPS_TOKEN в local/.env
SITE_TOKEN=REPLACE_random_hex_32

SITE_OFFLINE_ALERT_AFTER=180      # написать в чат, если объект не выходит на связь дольше N секунд
LOG_LEVEL=INFO
