# Настройки VPS. setup.sh создаёт .env из этого файла и заполняет ключи сам.

# Доменное имя VPS (A-запись должна указывать на IP сервера) — будет HTTPS.
# Без домена: SITE_ADDRESS=:80 (только HTTP, см. docs/vps.md)
SITE_ADDRESS=vps.example.ru
TZ=Europe/Moscow

# Битрикс24 (docs/vps.md, шаг «Битрикс24»)
B24_WEBHOOK_URL=                  # входящий вебхук с правами imbot
B24_BOT_TOKEN=REPLACE_random_32   # секрет бота, до 40 символов; не меняйте после первого запуска
B24_USER_IDS=                     # ID сотрудников, которым можно управлять воротами, через запятую
B24_DIALOG_ID=                    # пусто — бот сам создаст чат «Ворота»; или chat123

# Связь с ПК у ворот: то же значение впишите в local/.env (LINK_TOKEN)
LINK_TOKEN=REPLACE_random_hex_32

SITE_OFFLINE_ALERT_AFTER=180      # написать в чат, если объект не на связи дольше N секунд
MAX_COMMAND_AGE=120               # «открыть», нажатое раньше чем N секунд назад, не выполняется
LOG_LEVEL=INFO
