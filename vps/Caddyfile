# /link          — подключение ПК у ворот к боту (WebSocket)
# /bot/healthz   — состояние бота (для проверки)
# всё остальное  — веб-интерфейс Uptime Kuma и адреса /api/push/...
{$SITE_ADDRESS} {
	encode gzip

	handle /link {
		reverse_proxy bot:8080
	}

	handle /bot/healthz {
		rewrite * /healthz
		reverse_proxy bot:8080
	}

	handle {
		reverse_proxy kuma:3001
	}
}
