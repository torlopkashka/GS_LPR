# Скопируйте в .env и заполните (setup.ps1 делает это автоматически).
TZ=Europe/Moscow

ADMIN_USER=admin
ADMIN_PASSWORD=change-me-strong-password
SECRET_KEY=REPLACE_random_hex_32
AGENT_TOKEN=REPLACE_random_hex_32     # тот же токен — в agent\agent.yaml
API_TOKEN=                            # необязательно: для /api/open из автоматизаций

# Битрикс24 (см. docs/local.md)
B24_WEBHOOK_URL=                      # входящий вебхук с правами imbot: https://портал.bitrix24.ru/rest/1/xxxx/
B24_BOT_TOKEN=REPLACE_random_hex_32   # секрет бота, до 40 символов; не меняйте после регистрации
B24_USER_IDS=                         # ID сотрудников, которым можно управлять воротами, через запятую
B24_DIALOG_ID=                        # необязательно: chat123 — свой чат; пусто — бот создаст чат «Ворота»

# Uptime Kuma на VPS (docs/vps.md). Если ПК или интернет на объекте пропадут,
# Kuma сам пришлёт уведомление. Адрес монитора: http://IP-VPS:3001/api/push/<токен>
HEALTHCHECK_URL=

COOKIE_SECURE=0
LOG_LEVEL=INFO
