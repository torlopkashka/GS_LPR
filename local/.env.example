# Настройки ПК у ворот. setup.ps1 создаёт .env из этого файла.
TZ=Europe/Moscow

ADMIN_USER=admin
ADMIN_PASSWORD=change-me-strong-password
SECRET_KEY=REPLACE_random_hex_32
AGENT_TOKEN=REPLACE_random_hex_32     # тот же токен — в agent\agent.yaml
API_TOKEN=                            # необязательно: для /api/open из автоматизаций

# Связь с VPS, на котором работают бот Битрикс24 и Uptime Kuma (docs/local.md)
VPS_LINK_URL=wss://vps.example.ru/link   # без домена: ws://IP-VPS/link
LINK_TOKEN=                              # скопируйте LINK_TOKEN из vps/.env

# Монитор Uptime Kuma на VPS (тип Push). Если ПК или интернет на объекте пропадут,
# Kuma сам пришлёт уведомление. Пример: https://vps.example.ru/api/push/AbCdEf1234
HEALTHCHECK_URL=

COOKIE_SECURE=0
LOG_LEVEL=INFO
