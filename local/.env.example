# Скопируйте в .env и заполните (setup.ps1 делает это автоматически).
TZ=Europe/Moscow

ADMIN_USER=admin
ADMIN_PASSWORD=change-me-strong-password
SECRET_KEY=REPLACE_random_hex_32
AGENT_TOKEN=REPLACE_random_hex_32     # тот же токен — в agent\agent.yaml
API_TOKEN=                            # необязательно: для доступа к /api/* из других программ

# Бот Битрикс24 на VPS: сюда уходят уведомления, отсюда приходят правки списка номеров
VPS_URL=                              # http://IP-VPS:8080
VPS_TOKEN=                            # значение SITE_TOKEN из vps/.env

# Uptime Kuma на VPS (docs/vps.md). Если ПК или интернет на объекте пропадут,
# Kuma сам пришлёт уведомление. Адрес монитора: http://IP-VPS:3001/api/push/<токен>
HEALTHCHECK_URL=

COOKIE_SECURE=0
LOG_LEVEL=INFO
